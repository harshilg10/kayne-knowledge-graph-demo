  caption: "{name}";
}
node.Advisor {
  color: #1E8E5A;
  border-color: #136B42;
  diameter: 55px;
  caption: "{name}";
}
node.Document {
  color: #8D99AE;
  border-color: #6B778C;
  diameter: 50px;
  caption: "{title}";
}
node.Meeting {
  color: #00A3BF;
