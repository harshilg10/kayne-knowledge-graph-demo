node {
  diameter: 50px;
  color: #A5ABB6;
  border-color: #9AA1AC;
  border-width: 2px;
  text-color-internal: #FFFFFF;
  font-size: 10px;
}
relationship {
  color: #A5ABB6;
  shaft-width: 1px;
  font-size: 8px;
  padding: 3px;
  text-color-external: #000000;
  text-color-internal: #FFFFFF;
  caption: "<type>";
}
node.Client {
  color: #E8A33D;
  border-color: #B97E22;
  diameter: 75px;
  font-size: 11px;
  caption: "{name}";
}
node.Account {
  color: #F2C879;
  border-color: #C9A04F;
  text-color-internal: #3A2A06;
  diameter: 45px;
  caption: "{id}";
}
node.Fund {
  color: #4C8BF5;
  border-color: #2F66C4;
  diameter: 65px;
  caption: "{name}";
}
node.Company {
  color: #7B61FF;
  border-color: #5A43D6;
  diameter: 55px;
  caption: "{name}";
}
node.Theme {
  color: #E5484D;
  border-color: #B4282D;
  diameter: 75px;
  font-size: 11px;
  caption: "{name}";
}
node.Concept {
  color: #F28B82;
  border-color: #D0645B;
