// =====================================================================================
// Knowledge Graph Demo - Neo4j Browser query pack (generated by kgdemo/export_queries.py)
// 1. Open http://localhost:7474/browser/ and connect.
// 2. Optional styling: run  :style  and drag neo4j/browser_style.grass into the style panel.
// 3. Run the :params line below once, then run any query (copy one block at a time).
// =====================================================================================

:params {theme: 'AI Infrastructure', phrase: '"AI infrastructure"', client: 'Hartwell Family Trust', as_of: '2026-09-30', company: 'Nvidia', borrower: 'Cobalt Ridge Data Centers'}

// ---- 01. Find all documents discussing a theme (from the brief)
// Q: Which documents discuss AI Infrastructure?
// Why it matters: Returns documents that never literally say 'AI infrastructure' - the semantic model maps 'GPU capacity', 'hyperscaler capex' or 'liquid cooling' to the theme.
MATCH (d:Document)-[:MENTIONS]->(t:Theme {name:'AI Infrastructure'})
RETURN d;

// ---- 02. Find people discussing Nvidia (from the brief)
// Q: Who has been in meetings where Nvidia was discussed?
// Why it matters: Two hops across meeting notes: attendance comes from the participant list, discussion from the text.
MATCH (p:Person)-[:ATTENDED]->(m:Meeting)-[:DISCUSSED]->(c:Company {name:'Nvidia'})
RETURN DISTINCT p;

// ---- 03. Trace investment impact (from the brief)
// Q: Which clients own which funds, and what do those funds invest in?
// Why it matters: OWNS is a business definition in the semantic model (client -> account -> holding), materialized as one relationship.
MATCH (c:Client)-[:OWNS]->(f:Fund)-[:INVESTED_IN]->(co:Company)
RETURN c,f,co;

// ---- 04. Theme search with explanations
// Q: Which documents discuss a theme, and why was each one returned?
// Why it matters: Every inferred link keeps the concept that triggered it - the answer is explainable.
MATCH (d:Document)-[r:MENTIONS]->(t:Theme {name: $theme})
RETURN d.date AS date, d.doc_type AS type, d.title AS title, d.id AS doc_id,
       CASE WHEN r.inferred THEN 'concept: ' + r.via ELSE 'explicit mention' END AS why
ORDER BY date DESC;

// ---- 05. Keyword search vs semantic model
// Q: How many relevant documents does plain keyword search miss?
// Why it matters: Keyword search only finds the literal phrase. The semantic layer also finds documents about GPU capacity, AI data centers, liquid cooling or hyperscaler capex.
CALL db.index.fulltext.queryNodes('documentText', $phrase) YIELD node
WITH collect(node.id) AS keyword_hits
MATCH (d:Document)-[r:MENTIONS]->(:Theme {name: $theme})
WITH keyword_hits, d, collect(r.via) AS vias
RETURN d.id AS doc_id, toString(d.date) AS date, d.title AS title, d.doc_type AS type,
       d.id IN keyword_hits AS found_by_keyword,
       [v IN vias WHERE v IS NOT NULL] AS matched_via_concepts
ORDER BY found_by_keyword, d.date DESC;

// ---- 06. Everything AI-infrastructure related that impacted a client (last 12 months)
// Q: Show me everything related to AI infrastructure investments that impacted the Hartwell Family Trust in the last 12 months.
// Why it matters: One question, five systems: portfolio accounting, order management, CRM, email and meeting notes - connected through the client and the theme.
WITH date($as_of) - duration('P12M') AS since
MATCH (c:Client {name: $client}), (t:Theme {name: $theme})
CALL (c, t, since) {
  MATCH p = (c)-[:OWNS]->(:Fund)-[:INVESTED_IN]->(:Company)-[:EXPOSED_TO]->(t)
  RETURN p
  UNION
  MATCH p = (c)-[:HAS_ACCOUNT]->(:Account)-[:HAS_TRANSACTION]->(x:Transaction)-[:PURSUANT_TO]->(:Decision)-[:AFFECTS]->(t)
  WHERE x.date >= since
  RETURN p
  UNION
  MATCH p = (c)<-[:ABOUT|MENTIONS]-(d:Document)-[:MENTIONS]->(t)
  WHERE d.date >= since
  RETURN p
  UNION
  MATCH p = (c)<-[:CONTACT_FOR]-(:Person)<-[:SENT_TO]-(d:Document)-[:MENTIONS]->(t)
  WHERE d.date >= since
  RETURN p
  UNION
  MATCH p = (c)<-[:ABOUT|MENTIONS]-(d:Document)-[:MENTIONS]->(:Fund)-[:FOCUSES_ON]->(t)
  WHERE d.date >= since
  RETURN p
  UNION
  MATCH p = (c)<-[:ABOUT|MENTIONS]-(d:Document)-[:REFERENCES]->(:Decision)-[:AFFECTS]->(t)
  WHERE d.date >= since
  RETURN p
  UNION
  MATCH p = (c)<-[:FOR_CLIENT]-(m:Meeting)-[:DISCUSSED]->(t)
  WHERE m.date >= since
  RETURN p
}
RETURN p;

// ---- 07. Look-through theme exposure by client
// Q: Which clients have the most look-through exposure to AI Infrastructure?
// Why it matters: Exposure the fund labels hide: a 'Global Technology' fund and a private credit loan both carry AI Infrastructure risk. Guideline is 15%.
MATCH (c:Client)-[:HAS_ACCOUNT]->(:Account)-[h:HOLDS]->(f:Fund)
WITH c, f, sum(h.market_value) AS value
OPTIONAL MATCH (f)-[i:INVESTED_IN]->(:Company)-[e:EXPOSED_TO]->(:Theme {name: $theme})
WITH c, f, value,
     sum(coalesce(i.weight, 0.0) / 100.0 *
         CASE e.degree WHEN 'high' THEN 1.0 WHEN 'medium' THEN 0.5 WHEN 'low' THEN 0.25 ELSE 0.0 END) AS factor
WITH c, sum(value) AS total, sum(value * factor) AS exposed
RETURN c.name AS client, round(total) AS total_usd, round(exposed) AS exposed_usd,
       round(1000.0 * exposed / total) / 10.0 AS exposure_pct
ORDER BY exposure_pct DESC;

// ---- 08. Hidden single-name concentration
// Q: Through which funds does a client own Nvidia, and how much?
// Why it matters: Answers the trustee's question from March: how much Nvidia do we really own?
MATCH (c:Client {name: $client})-[o:OWNS]->(f:Fund)-[i:INVESTED_IN]->(co:Company {name: $company})
RETURN f.name AS fund, o.market_value AS client_position_usd, i.weight AS weight_pct,
       round(o.market_value * i.weight / 100.0) AS look_through_usd
ORDER BY look_through_usd DESC;

// ---- 09. Decision provenance
// Q: What discussions led us to increase AI infrastructure exposure?
// Why it matters: From the decision back to the memo, the research it cited, the meetings and the people.
MATCH (t:Theme {name: $theme})<-[:AFFECTS]-(dec:Decision {direction: 'increase'})
CALL (t, dec) {
  MATCH p = (dec)<-[:PROPOSES]-(:Document)<-[:AUTHORED]-(:Person)
  RETURN p
  UNION
  MATCH p = (dec)<-[:PROPOSES]-(:Document)-[:CITES]->(:Document)<-[:AUTHORED]-(:Person)
  RETURN p
  UNION
  MATCH p = (dec)<-[:DECIDED]-(:Meeting)<-[:ATTENDED]-(:Person)
  RETURN p
  UNION
  MATCH p = (t)<-[:DISCUSSED]-(m:Meeting)<-[:ATTENDED]-(:Person)
  WHERE m.date < dec.date AND m.date >= dec.date - duration('P120D')
  RETURN p
}
RETURN p;

// ---- 10. Decision implementation
// Q: Which trades implemented each AI Infrastructure decision, and for which clients?
// Why it matters: Structured trades link to unstructured decisions through a shared identifier in the order reason.
MATCH (dec:Decision)-[:AFFECTS]->(:Theme {name: $theme})
MATCH (dec)<-[:PURSUANT_TO]-(x:Transaction)<-[:HAS_TRANSACTION]-(a:Account)<-[:HAS_ACCOUNT]-(c:Client)
MATCH (x)-[:INVOLVES]->(f:Fund)
RETURN dec.id AS decision, dec.date AS decided, count(DISTINCT c) AS clients,
       count(DISTINCT a) AS accounts, count(x) AS trades,
       sum(CASE WHEN x.txn_type IN ['BUY', 'CAPITAL_CALL'] THEN x.amount_usd ELSE 0 END) AS bought_usd,
       sum(CASE WHEN x.txn_type = 'SELL' THEN x.amount_usd ELSE 0 END) AS sold_usd
ORDER BY decided;

// ---- 11. Who are our experts on a theme?
// Q: Who in the firm knows the most about AI Infrastructure?
// Why it matters: Institutional knowledge: expertise inferred from who wrote and discussed what.
MATCH (t:Theme {name: $theme})
MATCH (p:Person)
OPTIONAL MATCH (p)-[:AUTHORED]->(d:Document)-[:MENTIONS]->(t)
WITH p, t, count(DISTINCT d) AS authored
OPTIONAL MATCH (p)-[:ATTENDED]->(m:Meeting)-[:DISCUSSED]->(t)
WITH p, authored, count(DISTINCT m) AS meetings
WHERE authored + meetings > 0
RETURN p.name AS person, p.title AS title, authored, meetings, 2 * authored + meetings AS score
ORDER BY score DESC, person LIMIT 10;

// ---- 12. Why is this client connected to this company?
// Q: How is the Hartwell Family Trust connected to Cobalt Ridge Data Centers?
// Why it matters: Explainability: the investment link (fund -> loan) and the conversation link (CRM notes) side by side.
MATCH (c:Client {name: $client}), (co:Company {name: $borrower})
MATCH p = allShortestPaths((c)-[*..4]-(co))
RETURN p LIMIT 25;

// ---- 13. Client -> Fund -> Nvidia -> Meeting Notes -> Investment Committee
// Q: Show the path from a client to the Investment Committee discussions about a company they own.
// Why it matters: The exact path sketched in the demo brief - traversed in both directions.
MATCH p = (c:Client {name: $client})-[:OWNS]->(:Fund)-[:INVESTED_IN]->(co:Company {name: $company})
          <-[:MENTIONS]-(:Document {doc_type: 'Meeting Notes'})-[:RECORDS]->(:Meeting)
          -[:HELD_BY]->(:Committee {name: 'Investment Committee'})
RETURN p;

// ---- 14. Show me the evidence
// Q: What exactly was said about Nvidia, where, and which engine extracted it?
// Why it matters: Every extracted relationship keeps its source document and the sentence that supports it.
MATCH (m:Meeting)-[r:DISCUSSED]->(:Company {name: $company})
RETURN m.date AS date, m.title AS meeting, r.evidence AS evidence, r.doc_id AS source_document,
       r.engine AS extracted_by
ORDER BY date;

// ---- 15. Time-aware retrieval
// Q: Which AI Infrastructure documents fall inside vs outside the last 12 months?
MATCH (d:Document)-[:MENTIONS]->(:Theme {name: $theme})
WITH d, d.date >= date($as_of) - duration('P12M') AS in_window
RETURN in_window, count(*) AS documents, collect(d.title)[..5] AS examples
ORDER BY in_window DESC;

// ---- 16. The schema the semantic model produced
// Q: What does the graph's schema look like?
CALL db.schema.visualization();
